---
import Base from '../layouts/Base.astro';
import { images, imageUrl } from '../data/images';
import type { Lang } from '../i18n/ui';
import Picture from '../components/Picture.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const fr = lang === 'fr';
---
<Base lang={lang} page="images" title="Images"
  description={fr ? 'Les images traitées dans FLOAT, chacune avec sa fiche : l’objet, la prise de vue et le graphe du traitement.' : 'Images processed in FLOAT, each with its own sheet: the object, the acquisition and the processing graph.'}>
  <div class="wide-page" style="padding-top: 2.6rem">
    <p class="kicker">{fr ? 'Fiches d’images' : 'Image sheets'}</p>
    <h1>Images</h1>
    <p class="measure">{fr
      ? 'Chaque image traitée dans FLOAT a sa fiche : l’objet, la prise de vue et le graphe du traitement.'
      : 'Each image processed in FLOAT has its own sheet: the object, the acquisition and the processing graph.'}</p>
    <div class="cols2" style="margin-top: 2rem">
      {images.map((s) => (
        <figure>
          <a href={imageUrl(s, lang)} style="text-decoration: none">
            <div class="plate"><Picture src={s.src} alt={s.alt[lang]} width={s.width} height={s.height} sizes="(min-width: 56rem) 45vw, 100vw" /></div>
          </a>
          <figcaption><b><a href={imageUrl(s, lang)}>{s.name[lang]}</a></b>{s.designation} · {s.frames}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</Base>
