      <li id="ref-1">Lehtinen, J. et al. 2018, <i lang="en">Noise2Noise: Learning Image Restoration without Clean Data</i>, ICML. <a href="https://arxiv.org/abs/1803.04189">arXiv:1803.04189</a></li>
      <li id="ref-2">Ronneberger, O., Fischer, P. &amp; Brox, T. 2015, <i lang="en">U-Net: Convolutional Networks for Biomedical Image Segmentation</i>, MICCAI 2015, LNCS 9351, 234. <a href="https://doi.org/10.1007/978-3-319-24574-4_28">doi:10.1007/978-3-319-24574-4_28</a></li>
    </ol>
  </section>
