---
// One page per block: the view src/views/blocks/<key>En.astro, once it exists.
import { blocks } from '../../i18n/ui';
export function getStaticPaths() {
  const views = import.meta.glob('../../views/blocks/*En.astro', { eager: true }) as Record<string, { default: any }>;
  return blocks
    .filter((b) => views[`../../views/blocks/${b.key}En.astro`])
    .map((b) => ({ params: { slug: b.slug.en }, props: { View: views[`../../views/blocks/${b.key}En.astro`].default } }));
}
const { View } = Astro.props;
---
<View />
