---
// A tutorial's video shown as a numbered figure on another page (the Why page), with a link to the tutorial.
// While the tutorial is not complete, the `fallback` slot is shown instead.
import { bySlug, tutorialUrl } from '../data/tutorials';
import { ui, type Lang } from '../i18n/ui';
interface Props { lang: Lang; n: number; slug: string }
const { lang, n, slug } = Astro.props;
const t = bySlug(slug);
const v = t?.video[lang];
const first = t?.steps[0];
const fr = lang === 'fr';
---
{t && v
  ? <figure id={`fig-${n}`} class="clip">
      <div class="plate">
        <video controls preload="metadata" playsinline poster={v.poster} src={v.src}
               style={first ? `aspect-ratio: ${first.w} / ${first.h}` : undefined}>
          {v.captions && <track kind="subtitles" default srclang={lang} label={fr ? 'Français' : 'English'} src={v.captions} />}
        </video>
      </div>
      <figcaption><b>{ui[lang].figure} {n}.</b>{' '}<slot />{' '}
        <a href={tutorialUrl(t, lang)}>{fr ? 'Le tutoriel, pas à pas' : 'The tutorial, step by step'}</a></figcaption>
    </figure>
  : <slot name="fallback" />}

<style>
  .clip video { display: block; width: 100%; height: auto; background: var(--plate); }
</style>
